<section class="hero"><div class="hero-copy"><span class="eyebrow">A TRAVEL WISHLIST & MEMORY BOOK</span><h1>Go somewhere.<br>Write it down.<br><em>Keep exploring.</em></h1><p>Places to visit, places remembered, and the stories in between.</p><%= link_to "Write a new post →", new_article_path, class: "button button-primary" %></div><div class="hero-aside" aria-hidden="true">POST<br>CARD<br>CLUB ↗</div></section>
<section class="list-heading"><div><span class="eyebrow">THE DESTINATION BOARD</span><h2>Where to next?</h2></div></section>
<div class="trip-boards"><div class="trip-board"><h2>✓ Been there <%= @visited.size %></h2><% @visited.each do |trip| %><div class="mini-card"><strong><%= link_to trip.title, article_path(trip) %></strong><small><%= trip.destination %></small></div><% end %></div><div class="trip-board wishlist"><h2>✦ Wishlist <%= @wishlist.size %></h2><% @wishlist.each do |trip| %><div class="mini-card"><strong><%= link_to trip.title, article_path(trip) %></strong><small><%= trip.destination %></small></div><% end %></div></div>
<section class="list-heading"><div><span class="eyebrow">LATEST POSTCARDS</span><h2>Stories from the map</h2></div></section><div class="filter-pills">
  <%= link_to "All", articles_path, class: (@selected.blank? ? "pill active" : "pill") %>
  <% Article::REGIONS.each do |value| %>
    <%= link_to value, articles_path(region: value), class: (@selected == value ? "pill active" : "pill") %>
  <% end %>
</div>
<div class="article-grid"><%= render partial: "card", collection: @articles, as: :article %></div>
<% if @articles.empty? %><div class="empty-state">No posts here yet. Choose another filter or write a new one.</div><% end %>
